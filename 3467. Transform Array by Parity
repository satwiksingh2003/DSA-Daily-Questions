class Solution {
    public int[] transformArray(int[] nums) {
        int evenCount = 0;
        // Count even numbers
        for (int num : nums) {
            if (num % 2 == 0) {
                evenCount++;
            }
        }
        // First all 0s (for even numbers)
        for (int i = 0; i < evenCount; i++) {
            nums[i] = 0;
        }
        // Then all 1s (for odd numbers)
        for (int i = evenCount; i < nums.length; i++) {
            nums[i] = 1;
        }
        return nums;
    }
}

class Solution {
    public boolean sumGame(String num) {
        int diff = 0;
        int q = 0;
        int n = num.length();
        for (int i = 0; i < n; i++) {
            char c = num.charAt(i);
            if (c == '?') {
                q += (i < n / 2) ? 1 : -1;
            } else {
                diff += (i < n / 2) ? c - '0' : -(c - '0');
            }
        }
        return diff * 2 != -9 * q;
    }
}

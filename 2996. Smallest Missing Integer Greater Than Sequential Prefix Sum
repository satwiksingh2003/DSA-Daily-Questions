class Solution {
    public int missingInteger(int[] nums) {
        int sum = nums[0];
        // Find sequential prefix sum
        for (int i = 1; i < nums.length; i++) {
            if (nums[i] == nums[i - 1] + 1) {
                sum += nums[i];
            } else {
                break;
            }
        }
        // Mark numbers present
        boolean[] present = new boolean[1001];
        for (int num : nums) {
            present[num] = true;
        }
        // Find smallest missing integer >= sum
        while (sum < present.length && present[sum]) {
            sum++;
        }
        return sum;
    }
}

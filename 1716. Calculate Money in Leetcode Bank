class Solution {
    public int totalMoney(int n) {
        int weeks = n / 7;
        int days = n % 7;
        int total = 0;
        // Sum of complete weeks
        total += 7 * weeks * (weeks + 1) / 2;
        total += 21 * weeks;
        // Sum of remaining days
        total += days * (days + 1) / 2;
        total += days * weeks;
        return total;
    }
}

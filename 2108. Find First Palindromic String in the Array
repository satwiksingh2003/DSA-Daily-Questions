class Solution {
    public String firstPalindrome(String[] words) {
        for (String st : words) {
            int left = 0;
            int right = st.length() - 1;
            while (left < right) {
                if (st.charAt(left) != st.charAt(right)) {
                    break;
                }
                left++;
                right--;
            }
            if (left >= right) {
                return st;
            }
        }
        return "";
    }
}



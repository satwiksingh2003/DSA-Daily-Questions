class Solution {
    public boolean isGood(int[] nums) {
        int n = nums.length;
        int[] freq = new int[n];
        for (int num : nums) {
            // number should be between 1 and n-1
            if (num < 1 || num > n - 1) {
                return false;
            }
            freq[num]++;
        }
        // 1 to n-2 should appear once
        for (int i = 1; i < n - 1; i++) {
            if (freq[i] != 1) {
                return false;
            }
        }
        // n-1 should appear twice
        return freq[n - 1] == 2;
    }
}

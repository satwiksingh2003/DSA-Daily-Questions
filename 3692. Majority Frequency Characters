import java.util.*;

class Solution {
    public String majorityFrequencyGroup(String s) {
        // Step 1: Count frequency of each character
        int[] count = new int[26];
        for (char ch : s.toCharArray()) {
            count[ch - 'a']++;
        }
        // Step 2: Group characters by their frequency
        Map<Integer, List<Character>> map = new HashMap<>();
        for (int i = 0; i < 26; i++) {
            if (count[i] > 0) {
                int freq = count[i];
                map.putIfAbsent(freq, new ArrayList<>());
                map.get(freq).add((char) (i + 'a'));
            }
        }
        // Step 3: Find the majority frequency group
        int maxSize = 0;
        int maxFreq = 0;
        for (Map.Entry<Integer, List<Character>> entry : map.entrySet()) {
            int freq = entry.getKey();
            int size = entry.getValue().size();
            if (size > maxSize || (size == maxSize && freq > maxFreq)) {
                maxSize = size;
                maxFreq = freq;
            }
        }
        // Step 4: Build the result
        StringBuilder result = new StringBuilder();
        for (char ch : map.get(maxFreq)) {
            result.append(ch);
        }
        return result.toString();
    }
}

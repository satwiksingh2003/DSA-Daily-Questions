class Solution {
    public String majorityFrequencyGroup(String s) {
        int[] count = new int[26];
        // Count frequency of each character
        for (char ch : s.toCharArray()) {
            count[ch - 'a']++;
        }
        int maxSize = 0;
        int maxFreq = 0;
        // Try every possible frequency
        for (int freq = 1; freq <= s.length(); freq++) {
            int size = 0;
            // Count characters having this frequency
            for (int i = 0; i < 26; i++) {
                if (count[i] == freq) {
                    size++;
                }
            }
            // Select the best frequency
            if (size > maxSize ||
                (size == maxSize && freq > maxFreq)) {

                maxSize = size;
                maxFreq = freq;
            }
        }
        // Build the answer
        StringBuilder result = new StringBuilder();
        for (int i = 0; i < 26; i++) {
            if (count[i] == maxFreq) {
                result.append((char) (i + 'a'));
            }
        }
        return result.toString();
    }
}


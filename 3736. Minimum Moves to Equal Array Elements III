class Solution {
    public int minMoves(int[] nums) {
        int max = Integer.MIN_VALUE;
        int ans = 0;
        for(int num : nums){
            max = Math.max(num, max);
        }
        for(int num : nums){
            ans += max - num;
        }
        return ans;
    }
}

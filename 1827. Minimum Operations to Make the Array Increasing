class Solution {
    public int minOperations(int[] nums) {
        int count = 0;
        for (int i = 1; i < nums.length; i++) {
            int required = nums[i - 1] + 1;
            if (nums[i] < required) {
                count += required - nums[i];
                nums[i] = required;
            }
        }
        return count;
    }
}

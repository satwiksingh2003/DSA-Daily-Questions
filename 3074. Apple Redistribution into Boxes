class Solution {
    public int minimumBoxes(int[] apple, int[] capacity) {
        int totalApple = 0;
        int count = 0;
        for(int i = 0; i<apple.length; i++){
            totalApple += apple[i];
        }
        Arrays.sort(capacity);
        for(int j = capacity.length-1; j>=0; j--){
            if(capacity[j]>=totalApple){
                count++;
                return count;
            }
            else{
                totalApple -= capacity[j];
                count++;
            }
        }
        return count;
    }
}


class Solution {
    public int minOperations(String s) {
        int n = s.length();
        // Already sorted
        boolean sorted = true;
        for (int i = 1; i < n; i++) {
            if (s.charAt(i) < s.charAt(i - 1)) {
                sorted = false;
                break;
            }
        }
        if (sorted) {
            return 0;
        }
        // For length 2, we cannot sort the entire string
        if (n == 2) {
            return -1;
        }
        // Find minimum and maximum characters
        char min = 'z';
        char max = 'a';
        for (char c : s.toCharArray()) {
            min = (char) Math.min(min, c);
            max = (char) Math.max(max, c);
        }
        // Minimum is already at the beginning
        // OR maximum is already at the end
        if (s.charAt(0) == min || s.charAt(n - 1) == max) {
            return 1;
        }
        // Minimum or maximum exists in the middle
        for (int i = 1; i < n - 1; i++) {
            if (s.charAt(i) == min || s.charAt(i) == max) {
                return 2;
            }
        }
        // Minimum is at the end and maximum is at the beginning
        return 3;
    }
}

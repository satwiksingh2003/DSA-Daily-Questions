class Solution {
    public int maxAscendingSum(int[] nums) {
        int currSum = nums[0];
        int maxSum = nums[0];
        if(nums.length == 1){
            return maxSum;
        }
        for(int i = 1; i < nums.length; i++){
            if (nums[i] > nums[i-1]){
                currSum += nums[i];
                maxSum = Math.max(currSum, maxSum);
            }
            else{
                currSum = 0;
                currSum += nums[i];
                maxSum = Math.max(currSum, maxSum);
            }
        }
        return maxSum;
    }
}

class Solution {
    public int minSwaps(int[] nums) {
        int n = nums.length;
        // Count total number of 1s
        int ones = 0;
        for (int num : nums) {
            if (num == 1) {
                ones++;
            }
        }
        // No swaps needed
        if (ones == 0 || ones == n) {
            return 0;
        }
        // Initial window of size 'ones'
        int currentOnes = 0;
        for (int i = 0; i < ones; i++) {
            if (nums[i] == 1) {
                currentOnes++;
            }
        }
        int maxOnes = currentOnes;
        // Sliding window over the circular array
        for (int i = ones; i < n + ones; i++) {
            // Add new element
            if (nums[i % n] == 1) {
                currentOnes++;
            }
            // Remove element leaving the window
            if (nums[(i - ones) % n] == 1) {
                currentOnes--;
            }
            maxOnes = Math.max(maxOnes, currentOnes);
        }
        return ones - maxOnes;
    }
}

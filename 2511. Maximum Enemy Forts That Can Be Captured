class Solution {
    public int captureForts(int[] forts) {
        int max = 0;
        int last = -1;
        for (int i = 0; i < forts.length; i++) {
            if (forts[i] == 1 || forts[i] == -1) {
                if (last != -1 && forts[last] != forts[i]) {
                    max = Math.max(max, i - last - 1);
                }
                last = i;
            }
        }
        return max;
    }
}

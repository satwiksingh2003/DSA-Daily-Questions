class Solution {
    public int maximumCount(int[] nums) {
        int n = nums.length;
        int left = 0;
        int right = n;
        // Find first non-negative element
        while (left < right) {
            int mid = left + (right - left) / 2;
            if (nums[mid] < 0) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }
        int negativeCount = left;
        left = 0;
        right = n;
        // Find first positive element
        while (left < right) {
            int mid = left + (right - left) / 2;
            if (nums[mid] <= 0) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }
        int positiveCount = n - left;
        return Math.max(negativeCount, positiveCount);
    }
}

class Solution {
    public String reversePrefix(String word, char ch) {
        int index = 0;
        for(int i = 0; i<word.length(); i++){
            if(ch==word.charAt(i)){
                index = i;
                break;
            }
        }
        if(index == 0){
            return word;
        }
        Stack <Character> st = new Stack <>(); // Deque <Character> st = new ArrayDeque <>();
        for(int j = 0; j<=index; j++){
            st.push(word.charAt(j));
        }
        StringBuffer str = new StringBuffer ();
        while(!st.isEmpty()){
            str.append(st.pop());
        }
        for(int k = index+1; k<word.length(); k++){
            str.append(word.charAt(k));
        }
        return str.toString();
    }
}

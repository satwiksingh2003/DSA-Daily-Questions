class Solution {
    public int findShortestSubArray(int[] nums) {
        int n = nums.length;
        int[] freq = new int[50000];
        int[] first = new int[50000];
        int degree = 0;
        int minLength = n;
        for (int i = 0; i < n; i++) {
            int num = nums[i];
            if (freq[num] == 0) {
                first[num] = i;
            }
            freq[num]++;
            if (freq[num] > degree) {
                degree = freq[num];
                minLength = i - first[num] + 1;
            }
            else if (freq[num] == degree) {
                minLength = Math.min(minLength, i - first[num] + 1);
            }
        }
        return minLength;
    }
}

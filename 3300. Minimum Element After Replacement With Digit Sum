class Solution {
    public int minElement(int[] nums) {
        int min = Integer.MAX_VALUE;
        for (int num : nums) {
            int sum = 0;
            while (num > 0) {
                sum += num % 10;  // get last digit
                num /= 10;        // remove last digit
            }
            min = Math.min(min, sum);
        }
        return min;
    }
}
